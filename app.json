{
  "expo": {
    "name": "יהודי 365",
    "slug": "jew-365",
    "version": "1.0.21",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jew365",
    "userInterfaceStyle": "automatic",
    "locales": {
      "he": "./locales/he.json",
      "en": "./locales/en.json"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jew365.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "מיקום נדרש לחישוב זמני הלכה מדויקים לפי האזור שלך.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "מיקום נדרש לחישוב זמני הלכה מדויקים ולרענון יומי של התראות.",
        "UIBackgroundModes": ["processing"],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#F6F1E8"
      },
      "package": "com.jew365.app",
      "allowBackup": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F1E8",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0E1626"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "מיקום נדרש לחישוב זמני הלכה מדויקים ולרענון יומי של התראות.",
          "locationAlwaysPermission": "מיקום נדרש לחישוב זמני הלכה מדויקים ולרענון יומי של התראות."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#012B97"
        }
      ],
      "./scripts/withMitzvahNotificationAction",
      "./scripts/withExactAlarmPermissions",
      "expo-task-manager",
      "expo-background-task",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./scripts/withAndroidBackupRules",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "זיהוי הפנים משמש לנעילת מסכי הטהרה בלבד"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "<sentry-org>",
          "project": "<sentry-project>",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "681ad224-93cc-4094-81cd-f70c48087485"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "jew-365-org",
    "updates": {
      "url": "https://u.expo.dev/681ad224-93cc-4094-81cd-f70c48087485"
    }
  }
}
