{
  "expo": {
    "name": "יהודי בזמן",
    "slug": "jew-in-time",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jewintime",
    "userInterfaceStyle": "automatic",
    "locales": {
      "he": "./locales/he.json",
      "en": "./locales/en.json"
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EFE4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jewintime.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "מיקום נדרש לחישוב זמני הלכה מדויקים לפי האזור שלך.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "מיקום נדרש לחישוב זמני הלכה מדויקים ולרענון יומי של התראות.",
        "UIBackgroundModes": ["processing"],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5EFE4"
      },
      "package": "com.jewintime.app",
      "allowBackup": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "מיקום נדרש לחישוב זמני הלכה מדויקים ולרענון יומי של התראות.",
          "locationAlwaysPermission": "מיקום נדרש לחישוב זמני הלכה מדויקים ולרענון יומי של התראות."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9922A"
        }
      ],
      "./scripts/withMitzvahNotificationAction",
      "./scripts/withExactAlarmPermissions",
      "expo-task-manager",
      "expo-background-task",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./scripts/withAndroidBackupRules",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "זיהוי הפנים משמש לנעילת מסכי הטהרה בלבד"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "<sentry-org>",
          "project": "<sentry-project>",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "8cc2a377-fcc9-4c78-bdde-ec0fc8f2a84e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8cc2a377-fcc9-4c78-bdde-ec0fc8f2a84e"
    }
  }
}
