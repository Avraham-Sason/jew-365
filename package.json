{
  "name": "jew-365",
  "version": "1.0.21",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "web": "node scripts/free-port.js 8081 && expo start --web",
    "free-port": "node scripts/free-port.js",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "update": "node scripts/publish-update.js preview",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:android:development": "npx eas-cli build --platform android --profile development",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "build:android:production-apk": "npx eas-cli build --platform android --profile production-apk",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --latest",
    "update:development": "node scripts/publish-update.js development",
    "update:preview": "node scripts/publish-update.js preview",
    "update:production": "node scripts/publish-update.js production",
    "test:tz": "node scripts/test-timezones.js",
    "check:dox": "node scripts/check-dox.js",
    "siddur:build": "node scripts/siddur/build.js",
    "chok:build": "node scripts/chok/build.js",
    "logo:build": "node design/jew365-concepts/vector/build.mjs && node scripts/logo/export.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/heebo": "^0.2.3",
    "@expo-google-fonts/noto-serif-hebrew": "^0.4.2",
    "@hebcal/core": "^5.4.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.12",
    "expo-background-task": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.20",
    "kosher-zmanim": "^0.9.0",
    "luxon": "^3.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@sentry/cli": "2.55.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?[/+].*|@expo-google-fonts[/+].*|react-navigation|@react-navigation[/+].*|@unimodules[/+].*|unimodules|sentry-expo|native-base|react-native-svg|kosher-zmanim|@hebcal[/+].*|luxon))"
    ],
    "setupFiles": [
      "<rootDir>/scripts/jest-timezone-setup.js"
    ],
    "moduleNameMapper": {
      "\\.siddur$": "<rootDir>/scripts/jest-asset-stub.js",
      "\\.chok$": "<rootDir>/scripts/jest-asset-stub.js",
      "(?:^|/)crashReporting$": "<rootDir>/src/services/crashReporting.ts"
    }
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
