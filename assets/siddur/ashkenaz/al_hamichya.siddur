{"nusach":"ashkenaz","id":"al_hamichya","sections":[{"title":{"he":"ברכה מעין שלוש","en":"Me'ein Shalosh"},"segments":[{"he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם,"}]]},{"he":[[{"t":"על חמשת מיני דגן—","s":"n"},{"t":"עַל הַמִּחְיָה וְעַל הַכַּלְכָּלָה"}]]},{"he":[[{"t":"על היין—","s":"n"},{"t":"עַל הַגֶּפֶן וְעַל פְּרִי הַגֶּפֶן"}]]},{"he":[[{"t":"על פירות משבעת המינים—","s":"n"},{"t":"עַל הָעֵץ וְעַל פְּרִי הָעֵץ"}]]},{"he":[[{"t":"וְעַל תְּנוּבַת הַשָּׂדֶה וְעַל אֶרֶץ חֶמְדָּה טוֹבָה וּרְחָבָה שֶׁרָצִיתָ וְהִנְחַלְתָּ לַאֲבוֹתֵינוּ לֶאֱכוֹל מִפִּרְיָהּ וְלִשְׂבּוֹעַ מִטּוּבָהּ. רַחֵם (נָא) יְהֹוָה אֱלֹהֵינוּ עַל יִשְׂרָאֵל עַמֶּךָ וְעַל יְרוּשָׁלַיִם עִירֶךָ וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדֶךָ, וְעַל מִזְבְּחֶךָ, וְעַל הֵיכָלֶךָ. וּבְנֵה יְרוּשָׁלַיִם עִיר הַקּדֶשׁ בִּמְהֵרָה בְיָמֵינוּ. וְהַעֲלֵנוּ לְתוֹכָהּ וְשַׂמְּחֵנוּ בְּבִנְיָנָהּ, וְנֹאכַל מִפִּרְיָּהּ וְנִשְׂבַּע מִטּוּבָהּ וּנְבָרֶכְךָ עָלֶיהָ בִּקְדֻשָּׁה וּבְטָהֳרָה."}]]},{"he":[[{"t":"בראש חודש:","s":"n","when":{"any":["roshChodesh","roshChodeshYesterday"]}},{"t":" וְזָכְרֵנוּ לְטוֹבָה בְּיוֹם רֹאשׁ הַחֹדֶשׁ הַזֶּה.","when":{"any":["roshChodesh","roshChodeshYesterday"]}},{"t":"בחול המועד:","s":"n","when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday","cholHamoedSukkot","cholHamoedSukkotYesterday"]}},{"t":" וְשַׂמְּחֵנוּ בְיוֹם ","when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday","cholHamoedSukkot","cholHamoedSukkotYesterday"]}},{"t":"חַג הַמַּצּוֹת הַזֶּה, ","when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday"]}},{"t":"חַג הַסֻּכּוֹת הַזֶּה, ","when":{"any":["cholHamoedSukkot","cholHamoedSukkotYesterday"]}},{"t":"בְּיוֹם מִקְרָא קֹדֶשׁ הַזֶּה.","when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday","cholHamoedSukkot","cholHamoedSukkotYesterday"]}}]],"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"he":[[{"t":"כִּי אַתָּה יְהֹוָה טוֹב וּמֵטִיב לַכּל וְנוֹדֶה לְּךָ עַל הָאָרֶץ"}]]},{"he":[[{"t":"על חמשת מיני דגן—","s":"n"},{"t":"וְעַל הַמִּחְיָה"}]]},{"he":[[{"t":"על היין—","s":"n"},{"t":"וְעַל פְּרִי הַגָּֽפֶן"}]]},{"he":[[{"t":"על פירות משבעת המינים—","s":"n"},{"t":"וְעַל הַפֵּרוֹת"}]]},{"he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה, עַל הָאָרֶץ"}]]},{"he":[[{"t":"על חמשת מיני דגן—","s":"n"},{"t":"וְעַל הַמִּחְיָה ("},{"t":"וי\"א גם","s":"n"},{"t":" וְעַל הַכַּלְכָּלָה)."}]]},{"he":[[{"t":"על היין—","s":"n"},{"t":"וְעַל פְּרִי הַגָּֽפֶן."}]]},{"he":[[{"t":"על פירות משבעת המינים—","s":"n"},{"t":"וְעַל הַפֵּרוֹת."}]]}]},{"title":{"he":"לפירות ארץ ישראל","en":"For Produce of the Land of Israel"},"optional":{"he":"לפירות ארץ ישראל","en":"For produce of the Land of Israel"},"segments":[{"he":[[{"t":"על פירות ארץ ישראל מסיימים:","s":"n"}]],"en":"For produce of the Land of Israel, the blessing ends:"},{"he":[[{"t":"על חמשת מיני דגן—","s":"n"},{"t":"וְעַל הַמִּחְיָה"}]]},{"he":[[{"t":"על היין—","s":"n"},{"t":"וְעַל פְּרִי גַפְנָהּ"}]]},{"he":[[{"t":"על פירות משבעת המינים—","s":"n"},{"t":"וְעַל פֵּרוֹתֶיהָ"}]]},{"he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה, עַל הָאָרֶץ"}]]},{"he":[[{"t":"על חמשת מיני דגן—","s":"n"},{"t":"וְעַל הַמִּחְיָה ("},{"t":"וי\"א גם","s":"n"},{"t":" וְעַל הַכַּלְכָּלָה)."}]]},{"he":[[{"t":"על היין—","s":"n"},{"t":"וְעַל פְּרִי גַפְנָהּ."}]]},{"he":[[{"t":"על פירות משבעת המינים—","s":"n"},{"t":"וְעַל פֵּרוֹתֶיהָ."}]]}]}],"credits":[{"title":"Siddur Ashkenaz — Daat Siddur Ashkenaz","license":"Public Domain","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}