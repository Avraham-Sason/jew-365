{"nusach":"sefard","id":"al_hamichya","sections":[{"title":{"he":"ברכה מעין שלוש","en":"Me'ein Shalosh"},"segments":[{"he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם:"}]]},{"he":[[{"t":"על היין:","s":"n"},{"t":" עַל הַגֶּפֶן וְעַל פְּרִי הַגֶּפֶן:"}]]},{"he":[[{"t":"על פירות משבעת המינים:","s":"n"},{"t":" עַל הָעֵץ וְעַל פְּרִי הָעֵץ:"}]]},{"he":[[{"t":"על מזונות:","s":"n"},{"t":" עַל הַמִחְיָה וְעַל הַכַּלְכָּלָה:"}]]},{"he":[[{"t":"על מזונות ויין ביחד:","s":"n"},{"t":" עַל הַמִּחְיָה וְעַל הַכַּלְכָּלָה וְעַל הַגֶּפֶן וְעַל פְּרִי הַגֶּפֶן:"}]]},{"he":[[{"t":"וְעַל תְּנוּבַת הַשָּׂדֶה","s":"b"},{"t":" וְעַל אֶרֶץ חֶמְדָּה טוֹבָה וּרְחָבָה שֶׁרָצִיתָ וְהִנְחַלְתָּ לַאֲבוֹתֵינוּ לֶאֱכֹל מִפִּרְיָהּ וְלִשְׂבּוֹעַ מִטּוּבָהּ, רַחֵם "},{"t":"(נָא)","s":"n"},{"t":" יְהֹוָה אֱלֹהֵינוּ עַל יִשְׂרָאֵל עַמֶּךָ וְעַל יְרוּשָׁלַיִם עִירֶךָ וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדֶךָ וְעַל מִזְבְּחֶךָ וְעַל הֵיכָלֶךָ, וּבְנֵה יְרוּשָׁלַיִם עִיר הַקֹּדֶשׁ בִּמְהֵרָה בְּיָמֵינוּ וְהַעֲלֵנוּ לְתוֹכָהּ וְשַׂמְּחֵנוּ בְּבִנְיָנָהּ וְנֹאכַל מִפִּרְיָּהּ וְנִשְׂבַּע מִטּוּבָהּ וּנְבָרֶכְךָ עָלֶיהָ בִּקְדֻשָּׁה וּבְטָהֳרָה:"}]]},{"he":[[{"t":"(בר\"ח:) ","s":"n"},{"t":"וְזָכְרֵנוּ לְטוֹבָה בְּיוֹם רֹאשׁ הַחֹדֶשׁ הַזֶּה:","s":"b"}]],"when":{"any":["roshChodesh","roshChodeshYesterday"]},"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"he":[[{"t":"(בחול המועד:) ","s":"n"},{"t":"וְשַׂמְחֵנוּ בְּיוֹם חַג ","s":"b"},{"t":"הַמַּצּוֹת","s":"b","when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday"]}},{"t":"הַסֻּכּוֹת","s":"b","when":{"any":["cholHamoedSukkot","cholHamoedSukkotYesterday"]}},{"t":" הַזֶּה:","s":"b"}]],"when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday","cholHamoedSukkot","cholHamoedSukkotYesterday"]},"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"he":[[{"t":"כִּי אַתָּה","s":"b"},{"t":" יְהֹוָה טוֹב וּמֵטִיב לַכֹּל וְנוֹדֶה לְךָ עַל הָאָרֶץ וְעַל:"}]]},{"he":[[{"t":"(על היין:)","s":"n"},{"t":" פְּרִי הַגָּפֶן: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל פְּרִי הַגָּפֶן:"}]]},{"he":[[{"t":"(על הפירות:)","s":"n"},{"t":" הַפֵּרוֹת: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל הַפֵּרוֹת:"}]]},{"he":[[{"t":"(על מזונות:)","s":"n"},{"t":" הַמִחְיָה: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל הַמִחְיָה וְעַל הַכַּלְכָּלָה:"}]]},{"he":[[{"t":"(על מזונות ויין ביחד:)","s":"n"},{"t":" הַמִּחְיָה וְעַל פְּרִי הַגָּפֶן: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל הַמִחְיָה וְעַל הַכַּלְכָּלָה וְעַל פְּרִי הַגָּפֶן:"}]]}]},{"title":{"he":"לפירות ארץ ישראל","en":"For Produce of the Land of Israel"},"optional":{"he":"לפירות ארץ ישראל","en":"For produce of the Land of Israel"},"segments":[{"he":[[{"t":"על פירות ארץ ישראל מסיימים:","s":"n"}]],"en":"For produce of the Land of Israel, the blessing ends:"},{"he":[[{"t":"(על היין:)","s":"n"},{"t":" פְּרִי הַגָּפֶן: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל פְּרִי גַפְנָהּ:"}]]},{"he":[[{"t":"(על הפירות:)","s":"n"},{"t":" הַפֵּרוֹת: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל פֵּרוֹתֶיהָ:"}]]},{"he":[[{"t":"(על מזונות:)","s":"n"},{"t":" הַמִחְיָה: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל הַמִחְיָה וְעַל הַכַּלְכָּלָה:"}]]},{"he":[[{"t":"(על מזונות ויין ביחד:)","s":"n"},{"t":" הַמִּחְיָה וְעַל פְּרִי הַגָּפֶן: בָּרוּךְ אַתָּה יְהֹוָה עַל הָאָרֶץ וְעַל הַמִחְיָה וְעַל הַכַּלְכָּלָה וְעַל פְּרִי גַפְנָהּ:"}]]}]}],"credits":[{"title":"Siddur Sefard — Torat Emet 357","license":"Public Domain","url":"https://www.sefaria.org/Siddur_Sefard"}]}